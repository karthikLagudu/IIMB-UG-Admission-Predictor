generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  OFFICIAL_POLICY
  OFFICIAL_OBSERVED_RESULT
  HISTORICAL_RTI
  MODEL_ASSUMPTION
  USER_INPUT
  CALCULATED
}

model AdmissionCycle {
  id            String     @id @default(cuid())
  name          String
  catYear       Int
  policyVersion String     @unique
  active        Boolean    @default(false)
  effectiveYear Int
  source        String
  sourceType    SourceType
  verifiedDate  DateTime
  notes         String
  config        Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  catCutoffs                CatCutoff[]
  academicRatingRules       AcademicRatingRule[]
  class12RatingRules        Class12RatingRule[]
  bachelorRatingRules       BachelorRatingRule[]
  academicCategories        AcademicCategory[]
  academicConsistencyRules  AcademicConsistencyRule[]
  stage1Rules               Stage1Rule[]
  stage1Thresholds          Stage1Threshold[]
  stage2Thresholds          Stage2Threshold[]
  historicalFinalBenchmarks HistoricalFinalBenchmark[]
  modelConfigs              ModelConfig[]
  predictionRuns            PredictionRun[]
}

model CatCutoff {
  id               String         @id @default(cuid())
  admissionCycleId String
  category         String
  pwd              Boolean
  overall          Float
  varc             Float
  dilr             Float
  qa               Float
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, category, pwd])
}

model AcademicRatingRule {
  id               String         @id @default(cuid())
  admissionCycleId String
  component        String
  appliesTo        String
  bands            Json
  maxScore         Float
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, component, appliesTo])
}

model Class12RatingRule {
  id               String         @id @default(cuid())
  admissionCycleId String
  stream           String
  bands            Json
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, stream])
}

model BachelorRatingRule {
  id               String         @id @default(cuid())
  admissionCycleId String
  academicCategory String
  bands            Json
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, academicCategory])
}

model AcademicCategory {
  id               String          @id @default(cuid())
  admissionCycleId String
  code             String
  label            String
  description      String
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle  @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)
  degreeMappings   DegreeMapping[]

  @@unique([admissionCycleId, code])
}

model DegreeMapping {
  id                 String           @id @default(cuid())
  academicCategoryId String
  degreeName         String
  normalizedName     String
  aliases            Json
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicCategory   AcademicCategory @relation(fields: [academicCategoryId], references: [id], onDelete: Cascade)

  @@unique([academicCategoryId, normalizedName])
}

model AcademicConsistencyRule {
  id               String         @id @default(cuid())
  admissionCycleId String
  stream           String
  candidateGroup   String
  threshold        Float
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, stream, candidateGroup])
}

model Stage1Rule {
  id               String         @id @default(cuid())
  admissionCycleId String
  route            String
  academicGroup    String
  categoryGroup    String
  upperLimit       Int?
  topPercent       Float
  criteria         Json
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, route, academicGroup, categoryGroup])
}

model Stage1Threshold {
  id               String         @id @default(cuid())
  admissionCycleId String
  categoryGroup    String
  academicCategory String
  minimumCs        Float
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, categoryGroup, academicCategory])
}

model Stage2Threshold {
  id               String         @id @default(cuid())
  admissionCycleId String
  categoryGroup    String
  minimumCs        Float
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, categoryGroup])
}

model HistoricalFinalBenchmark {
  id               String         @id @default(cuid())
  admissionCycleId String
  categoryGroup    String
  benchmarkCycle   String
  benchmark        Float
  offerCount       Int?
  waitlistMovement Int?
  effectiveYear    Int
  source           String
  sourceType       SourceType
  verifiedDate     DateTime
  notes            String
  admissionCycle   AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId, categoryGroup, benchmarkCycle])
}

model ModelConfig {
  id                      String         @id @default(cuid())
  admissionCycleId        String
  safetyMargin            Float
  logisticSlope           Float
  calibrationMethod       String
  benchmarkRecencyWeights Json
  probabilityBands        Json
  effectiveYear           Int
  source                  String
  sourceType              SourceType
  verifiedDate            DateTime
  notes                   String
  admissionCycle          AdmissionCycle @relation(fields: [admissionCycleId], references: [id], onDelete: Cascade)

  @@unique([admissionCycleId])
}

model Candidate {
  id             String          @id @default(cuid())
  category       String
  pwd            Boolean
  inputSnapshot  Json
  createdAt      DateTime        @default(now())
  predictionRuns PredictionRun[]
}

model PredictionRun {
  id               String            @id @default(cuid())
  candidateId      String
  admissionCycleId String
  policyVersion    String
  candidateInputs  Json
  policySnapshot   Json
  resultSnapshot   Json
  createdAt        DateTime          @default(now())
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  admissionCycle   AdmissionCycle    @relation(fields: [admissionCycleId], references: [id], onDelete: Restrict)
  result           PredictionResult?

  @@index([candidateId, createdAt])
  @@index([policyVersion])
}

model PredictionResult {
  id                  String        @id @default(cuid())
  predictionRunId     String        @unique
  status              String
  callPrediction      Boolean
  callRoute           String?
  compositeScore      Float?
  finalCompositeScore Float?
  seatProbability     Float
  predictionBand      String?
  explanation         Json
  createdAt           DateTime      @default(now())
  predictionRun       PredictionRun @relation(fields: [predictionRunId], references: [id], onDelete: Cascade)
}

// The undergraduate admissions domain is intentionally independent from the
// CAT/MBA AdmissionCycle graph above. A run always retains immutable policy,
// runtime-data, and result snapshots so later admin updates cannot rewrite it.
model IimbUgPolicy {
  id               String                  @id @default(cuid())
  policyId         String
  version          String                  @unique
  admissionCycle   String
  active           Boolean                 @default(false)
  effectiveYear    Int
  source           String
  sourceType       String
  verifiedDate     DateTime
  notes            String?
  config           Json
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  runtimeDatasets  IimbUgRuntimeDataset[]
  historicalCycles IimbUgHistoricalCycle[]
  predictionRuns   IimbUgPredictionRun[]
  sources          IimbUgSource[]

  @@index([active, updatedAt])
  @@index([policyId])
}

model IimbUgRuntimeDataset {
  id             String                @id @default(cuid())
  iimbUgPolicyId String
  version        String                @unique
  active         Boolean               @default(false)
  data           Json
  sourceType     String
  sourceLabel    String
  observedAt     DateTime?
  verifiedDate   DateTime
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  policy         IimbUgPolicy          @relation(fields: [iimbUgPolicyId], references: [id], onDelete: Restrict)
  predictionRuns IimbUgPredictionRun[]

  @@index([iimbUgPolicyId, active])
}

model IimbUgHistoricalCycle {
  id             String       @id @default(cuid())
  iimbUgPolicyId String
  cycle          String
  data           Json
  source         String
  sourceType     String
  verifiedDate   DateTime
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  policy         IimbUgPolicy @relation(fields: [iimbUgPolicyId], references: [id], onDelete: Restrict)

  @@unique([iimbUgPolicyId, cycle])
}

model IimbUgPredictionRun {
  id                     String                @id @default(cuid())
  iimbUgPolicyId         String
  iimbUgRuntimeDatasetId String?
  policyVersion          String
  runtimeVersion         String?
  calculationMode        String
  candidateInputs        Json
  policySnapshot         Json
  runtimeSnapshot        Json
  resultSnapshot         Json
  createdAt              DateTime              @default(now())
  policy                 IimbUgPolicy          @relation(fields: [iimbUgPolicyId], references: [id], onDelete: Restrict)
  runtimeDataset         IimbUgRuntimeDataset? @relation(fields: [iimbUgRuntimeDatasetId], references: [id], onDelete: SetNull)

  @@index([policyVersion, createdAt])
}

model IimbUgSource {
  id             String       @id @default(cuid())
  iimbUgPolicyId String
  sourceKey      String
  title          String
  institution    String
  url            String
  cycle          String?
  sourceType     String
  verifiedDate   DateTime
  supports       Json
  notes          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  policy         IimbUgPolicy @relation(fields: [iimbUgPolicyId], references: [id], onDelete: Restrict)

  @@unique([iimbUgPolicyId, sourceKey])
}
